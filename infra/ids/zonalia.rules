# Reglas propias de Zonalia (#24). Se suman a las de la comunidad.
# Detectan dos herramientas de escaneo por su User-Agent en el tráfico que llega a Nginx.
alert http any any -> any any (msg:"ZONALIA escaneo con sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000001; rev:1;)
alert http any any -> any any (msg:"ZONALIA escaneo con Nmap"; flow:established,to_server; http.user_agent; content:"Nmap"; nocase; classtype:attempted-recon; sid:9000002; rev:1;)