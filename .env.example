# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# PostgreSQL
POSTGRES_DB=zonalia
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_API_USER=
POSTGRES_API_PASSWORD=
POSTGRES_REPLICACION_USER=
POSTGRES_REPLICACION_PASSWORD=
POSTGRES_HOSTS=10.10.0.2,10.10.0.3
# Replicación (#19): IP donde se publica el puerto 5432 (127.0.0.1 en local; en N2 y N3, su IP de la VPN)
IP_PUBLICACION_DB=127.0.0.1
# En N3: IP de la VPN del primario
PRIMARIO_HOST=10.10.0.2
# Generador (#15) en N2: dónde está la base para cargar (localhost en local; en N2, 10.10.0.2)
POSTGRES_HOST_CARGA=localhost

# MongoDB
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=10.10.0.4

# API
JWT_SECRETO=
JWT_MINUTOS_EXPIRACION=480
CORS_ORIGENES=https://zonalia.local
LLAVE_CIFRADO_DESTINATARIO=
RUTA_LLAVE_PRIVADA_FIRMA=

# Bitácora de accesos (#16): vacío = salida de diagnóstico
BITACORA_ACCESOS_RUTA=
